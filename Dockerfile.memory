# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props ./
COPY src/Mintokei.Memory/ src/Mintokei.Memory/
COPY src/Mintokei.Memory.Postgres/ src/Mintokei.Memory.Postgres/
COPY src/Mintokei.Memory.Providers/ src/Mintokei.Memory.Providers/
COPY src/Mintokei.Memory.Hosting/ src/Mintokei.Memory.Hosting/
COPY src/Mintokei.Memory.Service/ src/Mintokei.Memory.Service/
RUN dotnet publish src/Mintokei.Memory.Service -c Release -r linux-x64 --self-contained true -o /out

FROM node:22-bookworm-slim
ARG CODEX_VERSION=0.165.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libicu72 git \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @openai/codex@${CODEX_VERSION} && npm cache clean --force \
    && groupadd -g 10001 memory && useradd -u 10001 -g memory -m memory \
    && mkdir /data && chown memory:memory /data
COPY --from=build /out /app
USER memory
WORKDIR /data
ENV HOME=/data CODEX_HOME=/data/.codex Memory__Root=/data ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
CMD ["/app/Mintokei.Memory.Service"]
