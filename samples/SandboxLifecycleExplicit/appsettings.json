{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5086", "Protocols": "Http1" },
      "Grpc": { "Url": "http://localhost:5087", "Protocols": "Http2" }
    }
  },
  "Sandbox": {
    "Backend": "docker",
    "Image": "ghcr.io/mintokei/mintokei-sandbox:latest",
    "DefaultProfile": "standard",
    "AllowedProfiles": [ "standard" ],
    "Profiles": {
      "standard": { "Runtime": "runc", "MemoryMb": 4096, "Cpus": 2 }
    },

    "BackendUrl": "http://host.docker.internal:5086",
    "GrpcBackendUrl": "http://host.docker.internal:5087",

    "//creds": "Optional. Point these at host paths to authenticate the in-container CLI (else the agent turn can't run). Each is mounted RO at /seed and copied into HOME by the entrypoint. e.g. ClaudeConfigHostDir=~/.claude, ClaudeConfigJsonHostFile=~/.claude.json.",
    "ClaudeConfigHostDir": "",
    "ClaudeConfigJsonHostFile": "",
    "CodexConfigHostDir": "",
    "GitCredentialsHostDir": ""
  }
}
