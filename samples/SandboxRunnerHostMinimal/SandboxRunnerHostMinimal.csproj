<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SandboxRunnerHostMinimal</RootNamespace>
  </PropertyGroup>

  <!-- The whole backend comes from ONE package: Mintokei.Sandbox.Hosting composes the runner host
       (transport + control plane + gRPC + SQLite + JWT) with the sandbox layer, and adds SandboxAgentHost. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Mintokei.Sandbox.Hosting\Mintokei.Sandbox.Hosting.csproj" />
  </ItemGroup>

</Project>
