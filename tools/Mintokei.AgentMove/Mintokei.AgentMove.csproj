<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>agentmove</AssemblyName>
    <RootNamespace>Mintokei.AgentMove</RootNamespace>
    <!-- Not published today. Flipping PackAsTool would make this a `dotnet tool install -g`
         command; left off until the CLI surface has settled. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mintokei.AgentMove.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mintokei.AgentEngine\Mintokei.AgentEngine.csproj" />
    <ProjectReference Include="..\..\src\Mintokei.AgentTranscripts\Mintokei.AgentTranscripts.csproj" />
  </ItemGroup>

</Project>
